/// Gregorian leap year: divisible by 4, except centuries not divisible by 400.

func is_leap_year(year: Int) -> Bool
    example 2000 -> true
    example 1900 -> false
    example 2024 -> true
    example 2023 -> false
    example 1600 -> true
    example 1700 -> false
    example 2012 -> true
    example 2100 -> false
    example 2400 -> true
    if year % 400 == 0 then
        return true
    else if year % 100 == 0 then
        return false
    else if year % 4 == 0 then
        return true
    else
        return false
    end if
end func

/// CLI: `<year>`.
func run(args: List[String]) -> Result[String, String]
    example ["2000"] -> Ok("leap=true")
    example ["1900"] -> Ok("leap=false")
    example ["2024"] -> Ok("leap=true")
    example ["2023"] -> Ok("leap=false")
    example [] -> Err("usage: <year>")
    example ["2000", "1"] -> Err("usage: <year>")
    example ["x"] -> Err("year must be an integer")
    if length(args) != 1 then
        return Err("usage: <year>")
    end if
    match parse_int(args[0]) with
    | None -> return Err("year must be an integer")
    | Some(y) ->
        var flag: String = "false"
        if is_leap_year(y) then
            flag = "true"
        end if
        return Ok("leap=" + flag)
    end match
end func

@untested("entry point")
func main() -> String
    match run(["2000"]) with
    | Ok(a) ->
        match run(["1900"]) with
        | Ok(b) ->
            match run(["2024"]) with
            | Ok(c) -> return a + " | " + b + " | " + c
            | Err(msg) -> return "error: " + msg
            end match
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

/// Gregorian leap year: divisible by 4, except centuries not divisible by 400.

func is_leap_year(year: Int) -> Bool
    example 2000 -> true
    example 1900 -> false
    example 2024 -> true
    example 2023 -> false
    example 1600 -> true
    example 1700 -> false
    example 2012 -> true
    if year % 400 == 0 then
        return true
    else if year % 100 == 0 then
        return false
    else if year % 4 == 0 then
        return true
    else
        return false
    end if
end func

@untested("entry point")
func main() -> String
    return "2000=" + to_string(is_leap_year(2000)) + " 1900=" + to_string(is_leap_year(1900)) + " 2024=" + to_string(is_leap_year(2024))
end func

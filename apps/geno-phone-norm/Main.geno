/// Normalize a phone string to digits only (optional leading + dropped).

import String

func is_digit(c: String) -> Bool
    example "0" -> true
    example "9" -> true
    example "+" -> false
    return c >= "0" and c <= "9"
end func

func normalize(phone: String) -> String
    example "" -> ""
    example "555-123-4567" -> "5551234567"
    example "(555) 123-4567" -> "5551234567"
    example "+1 (555) 123-4567" -> "15551234567"
    example "abc" -> ""
    example "12 34" -> "1234"
    var out: String = ""
    var i: Int = 0
    while i < length(phone) do
        let c: String = char_at(phone, i)
        if is_digit(c) then
            out = out + c
        end if
        i = i + 1
    end while
    return out
end func

@untested("entry point")
func main() -> String
    return normalize("(555) 123-4567") + " | " + normalize("+1-555-000-1111")
end func

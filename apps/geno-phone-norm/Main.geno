/// Normalize a phone string to digits only (optional leading + dropped).

import String

func is_digit(c: String) -> Bool
    example "0" -> true
    example "9" -> true
    example "+" -> false
    example " " -> false
    return c >= "0" and c <= "9"
end func

func normalize(phone: String) -> String
    example "" -> ""
    example "555-123-4567" -> "5551234567"
    example "(555) 123-4567" -> "5551234567"
    example "+1 (555) 123-4567" -> "15551234567"
    example "abc" -> ""
    example "12 34" -> "1234"
    example "+1-555-000-1111" -> "15550001111"
    var out: String = ""
    var i: Int = 0
    while i < length(phone) do
        let c: String = char_at(phone, i)
        if is_digit(c) then
            out = out + c
        end if
        i = i + 1
    end while
    return out
end func

/// CLI: joins all args as the phone string to normalize.
func run(args: List[String]) -> Result[String, String]
    example ["(555)", "123-4567"] -> Ok("5551234567")
    example ["+1", "(555)", "123-4567"] -> Ok("15551234567")
    example ["555-123-4567"] -> Ok("5551234567")
    example [] -> Err("usage: <phone...>")
    if length(args) == 0 then
        return Err("usage: <phone...>")
    end if
    return Ok(normalize(join(args, " ")))
end func

@untested("entry point")
func main() -> String
    match run(["(555)", "123-4567"]) with
    | Ok(a) ->
        match run(["+1-555-000-1111"]) with
        | Ok(b) -> return a + " | " + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

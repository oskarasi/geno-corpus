/// Standard amortizing mortgage monthly payment. Rate 0 uses principal / (years*12).

func pow_float(base: Float, exp: Int) -> Float
    example 2.0, 3 -> 8.0
    example 1.5, 0 -> 1.0
    example 1.1, 2 -> 1.2100000000000002
    var result: Float = 1.0
    var i: Int = 0
    while i < exp do
        result = result * base
        i = i + 1
    end while
    return result
end func

func monthly_payment(principal: Float, annual_rate_percent: Float, years: Int) -> Float
    example 120000.0, 0.0, 10 -> 1000.0
    example 0.0, 5.0, 30 -> 0.0
    if years <= 0 then
        return 0.0
    end if
    let months: Int = years * 12
    if annual_rate_percent == 0.0 then
        return principal / int_to_float(months)
    end if
    let r: Float = (annual_rate_percent / 100.0) / 12.0
    let factor: Float = pow_float(base: 1.0 + r, exp: months)
    return principal * (r * factor) / (factor - 1.0)
end func

@untested("entry point")
func main() -> String
    let p: Float = monthly_payment(principal: 200000.0, annual_rate_percent: 6.0, years: 30)
    let z: Float = monthly_payment(principal: 120000.0, annual_rate_percent: 0.0, years: 10)
    return "200k@6%/30y=" + to_string(p) + " 120k@0%/10y=" + to_string(z)
end func

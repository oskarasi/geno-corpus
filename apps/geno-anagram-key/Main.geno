/// Anagram key: lowercase letters only, sorted into a signature string.

import String

func normalize_letters(text: String) -> String
    example " Listen " -> "listen"
    example "A gentleman" -> "agentleman"
    example "123!" -> ""
    example "" -> ""
    var out: String = ""
    var i: Int = 0
    let lower: String = to_lower(text)
    while i < length(lower) do
        let c: String = char_at(lower, i)
        if c >= "a" and c <= "z" then
            out = out + c
        end if
        i = i + 1
    end while
    return out
end func

func anagram_key(text: String) -> String
    example "Listen" -> "eilnst"
    example "Silent" -> "eilnst"
    example "Hello World" -> "dehllloorw"
    example "" -> ""
    example "A gentleman" -> "aaeeglmnnt"
    example "123!" -> ""
    return join(sort_strings(to_chars(normalize_letters(text))), "")
end func

/// CLI: joins all args with spaces as the text.
func run(args: List[String]) -> Result[String, String]
    example ["Listen"] -> Ok("eilnst")
    example ["Hello", "World"] -> Ok("dehllloorw")
    example ["Silent"] -> Ok("eilnst")
    example [] -> Err("usage: <text...>")
    if length(args) == 0 then
        return Err("usage: <text...>")
    end if
    return Ok(anagram_key(join(args, " ")))
end func

@untested("entry point")
func main() -> String
    match run(["Listen"]) with
    | Ok(a) ->
        match run(["Silent"]) with
        | Ok(b) -> return "listen=" + a + " silent=" + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

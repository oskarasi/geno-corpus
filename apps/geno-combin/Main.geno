/// Binomial coefficient C(n, k) via multiplicative formula.

func combin(n: Int, k: Int) -> Result[Int, String]
    example 5, 2 -> Ok(10)
    example 5, 0 -> Ok(1)
    example 5, 5 -> Ok(1)
    example 10, 3 -> Ok(120)
    example 6, 3 -> Ok(20)
    example 0, 0 -> Ok(1)
    example 4, 5 -> Ok(0)
    example (-1), 2 -> Err("n must be non-negative")
    example 5, (-1) -> Err("k must be non-negative")
    if n < 0 then
        return Err("n must be non-negative")
    end if
    if k < 0 then
        return Err("k must be non-negative")
    end if
    if k > n then
        return Ok(0)
    end if
    var kk: Int = k
    if n - k < kk then
        kk = n - k
    end if
    var result: Int = 1
    var i: Int = 1
    while i <= kk do
        result = result * (n - kk + i) / i
        i = i + 1
    end while
    return Ok(result)
end func

@untested("entry point")
func main() -> String
    match combin(n: 10, k: 3) with
    | Ok(v) -> return "C(10,3)=" + to_string(v)
    | Err(e) -> return "error: " + e
    end match
end func

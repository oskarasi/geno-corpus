/// Armstrong (narcissistic) number: equals sum of its digits each raised to the digit count.

func pow_int(base: Int, exp: Int) -> Int
    requires exp >= 0
    ensures result >= 0
    example 2, 3 -> 8
    example 10, 0 -> 1
    example 5, 2 -> 25
    example 9, 3 -> 729
    var acc: Int = 1
    var i: Int = 0
    while i < exp do
        acc = acc * base
        i = i + 1
    end while
    return acc
end func

func digit_count(n: Int) -> Int
    requires n >= 0
    ensures result >= 1
    example 153 -> 3
    example 0 -> 1
    example 10 -> 2
    example 9474 -> 4
    if n == 0 then
        return 1
    end if
    var x: Int = n
    var count: Int = 0
    while x > 0 do
        count = count + 1
        x = x / 10
    end while
    return count
end func

func is_armstrong(n: Int) -> Bool
    example 153 -> true
    example 370 -> true
    example 371 -> true
    example 407 -> true
    example 9474 -> true
    example 100 -> false
    example 0 -> true
    example 1 -> true
    example (-153) -> false
    if n < 0 then
        return false
    end if
    let power: Int = digit_count(n)
    var x: Int = n
    var sum: Int = 0
    if n == 0 then
        return true
    end if
    while x > 0 do
        let d: Int = x % 10
        sum = sum + pow_int(d, power)
        x = x / 10
    end while
    return sum == n
end func

/// CLI: `<n>` reports whether n is Armstrong.
func run(args: List[String]) -> Result[String, String]
    example ["153"] -> Ok("153=true")
    example ["100"] -> Ok("100=false")
    example ["9474"] -> Ok("9474=true")
    example ["0"] -> Ok("0=true")
    example [] -> Err("usage: <n>")
    example ["x"] -> Err("n must be an integer")
    example ["1", "2"] -> Err("usage: <n>")
    if length(args) != 1 then
        return Err("usage: <n>")
    end if
    match parse_int(args[0]) with
    | None -> return Err("n must be an integer")
    | Some(n) -> return Ok(to_string(n) + "=" + to_string(is_armstrong(n)))
    end match
end func

@untested("entry point")
func main() -> String
    match run(["153"]) with
    | Ok(a) ->
        match run(["100"]) with
        | Ok(b) ->
            match run(["9474"]) with
            | Ok(c) -> return a + " " + b + " " + c
            | Err(msg) -> return "error: " + msg
            end match
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

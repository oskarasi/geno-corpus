/// Armstrong (narcissistic) number: equals sum of its digits each raised to the digit count.

func pow_int(base: Int, exp: Int) -> Int
    example 2, 3 -> 8
    example 10, 0 -> 1
    example 5, 2 -> 25
    var result: Int = 1
    var i: Int = 0
    while i < exp do
        result = result * base
        i = i + 1
    end while
    return result
end func

func digit_count(n: Int) -> Int
    example 153 -> 3
    example 0 -> 1
    example 10 -> 2
    if n == 0 then
        return 1
    end if
    var x: Int = n
    if x < 0 then
        x = 0 - x
    end if
    var count: Int = 0
    while x > 0 do
        count = count + 1
        x = x / 10
    end while
    return count
end func

func is_armstrong(n: Int) -> Bool
    example 153 -> true
    example 370 -> true
    example 371 -> true
    example 407 -> true
    example 9474 -> true
    example 100 -> false
    example 0 -> true
    example 1 -> true
    example (-153) -> false
    if n < 0 then
        return false
    end if
    let power: Int = digit_count(n)
    var x: Int = n
    var sum: Int = 0
    if n == 0 then
        return true
    end if
    while x > 0 do
        let d: Int = x % 10
        sum = sum + pow_int(d, power)
        x = x / 10
    end while
    return sum == n
end func

@untested("entry point")
func main() -> String
    return "153=" + to_string(is_armstrong(153)) + " 100=" + to_string(is_armstrong(100)) + " 9474=" + to_string(is_armstrong(9474))
end func

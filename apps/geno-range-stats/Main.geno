/// Min, max, and span (max - min) for a non-empty list of integers.

func min_int(xs: List[Int]) -> Result[Int, String]
    example [3, 1, 4] -> Ok(1)
    example [7] -> Ok(7)
    example [-2, -5, 0] -> Ok((-5))
    example [] -> Err("empty list")
    if length(xs) == 0 then
        return Err("empty list")
    end if
    var m: Int = xs[0]
    var i: Int = 1
    while i < length(xs) do
        if xs[i] < m then
            m = xs[i]
        end if
        i = i + 1
    end while
    return Ok(m)
end func

func max_int(xs: List[Int]) -> Result[Int, String]
    example [3, 1, 4] -> Ok(4)
    example [7] -> Ok(7)
    example [-2, -5, 0] -> Ok(0)
    example [] -> Err("empty list")
    if length(xs) == 0 then
        return Err("empty list")
    end if
    var m: Int = xs[0]
    var i: Int = 1
    while i < length(xs) do
        if xs[i] > m then
            m = xs[i]
        end if
        i = i + 1
    end while
    return Ok(m)
end func

func span(xs: List[Int]) -> Result[Int, String]
    example [3, 1, 4] -> Ok(3)
    example [7] -> Ok(0)
    example [-2, -5, 0] -> Ok(5)
    example [3, 1, 4, 1, 5] -> Ok(4)
    example [] -> Err("empty list")
    match min_int(xs) with
    | Err(e) -> return Err(e)
    | Ok(lo) ->
        match max_int(xs) with
        | Err(e2) -> return Err(e2)
        | Ok(hi) -> return Ok(hi - lo)
        end match
    end match
end func

/// CLI: `<ints...>` — report min, max, span.
func run(args: List[String]) -> Result[String, String]
    example ["3", "1", "4"] -> Ok("min=1 max=4 span=3")
    example ["7"] -> Ok("min=7 max=7 span=0")
    example ["-2", "-5", "0"] -> Ok("min=-5 max=0 span=5")
    example [] -> Err("usage: <ints...>")
    example ["x"] -> Err("values must be integers")
    if length(args) == 0 then
        return Err("usage: <ints...>")
    end if
    var xs: List[Int] = []
    var i: Int = 0
    while i < length(args) do
        match parse_int(args[i]) with
        | None -> return Err("values must be integers")
        | Some(v) -> xs = append(xs, v)
        end match
        i = i + 1
    end while
    match min_int(xs) with
    | Err(e) -> return Err(e)
    | Ok(lo) ->
        match max_int(xs) with
        | Err(e2) -> return Err(e2)
        | Ok(hi) -> return Ok("min=" + to_string(lo) + " max=" + to_string(hi) + " span=" + to_string(hi - lo))
        end match
    end match
end func

@untested("entry point")
func main() -> String
    match run(["3", "1", "4", "1", "5"]) with
    | Ok(a) ->
        match run(["-2", "-5", "0"]) with
        | Ok(b) -> return a + " | " + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

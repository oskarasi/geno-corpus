/// Count vowels (a,e,i,o,u) ignoring case; y is not a vowel.

import String

func is_vowel(c: String) -> Bool
    example "a" -> true
    example "E" -> true
    example "y" -> false
    example "b" -> false
    example "U" -> true
    example " " -> false
    let lower: String = to_lower(c)
    return lower == "a" or lower == "e" or lower == "i" or lower == "o" or lower == "u"
end func

func count_vowels(text: String) -> Int
    example "hello" -> 2
    example "AEIOU" -> 5
    example "rhythm" -> 0
    example "" -> 0
    example "Beautiful" -> 5
    example "Geno" -> 2
    var count: Int = 0
    var i: Int = 0
    while i < length(text) do
        if is_vowel(char_at(text, i)) then
            count = count + 1
        end if
        i = i + 1
    end while
    return count
end func

/// CLI: joins args with spaces, then counts vowels.
func run(args: List[String]) -> Result[String, String]
    example ["hello"] -> Ok("2")
    example ["Beautiful"] -> Ok("5")
    example ["rhythm"] -> Ok("0")
    example ["AEIOU", "y"] -> Ok("5")
    example [] -> Err("usage: <text...>")
    if length(args) == 0 then
        return Err("usage: <text...>")
    end if
    return Ok(to_string(count_vowels(join(args, " "))))
end func

@untested("entry point")
func main() -> String
    match run(["hello"]) with
    | Ok(a) ->
        match run(["Beautiful"]) with
        | Ok(b) -> return "hello=" + a + " Beautiful=" + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

/// Common elements of two List[Int], preserving order from the first list (deduped).

func contains_int(xs: List[Int], x: Int) -> Bool
    example [1, 2, 3], 2 -> true
    example [1, 2, 3], 9 -> false
    example [], 1 -> false
    var i: Int = 0
    while i < length(xs) do
        if xs[i] == x then
            return true
        end if
        i = i + 1
    end while
    return false
end func

func intersect(a: List[Int], b: List[Int]) -> List[Int]
    example [1, 2, 3, 2], [2, 4, 1] -> [1, 2]
    example [1, 2], [3, 4] -> []
    example [], [1] -> []
    example [5, 5, 6], [5] -> [5]
    example [9, 8, 7], [7, 9] -> [9, 7]
    var out: List[Int] = []
    var i: Int = 0
    while i < length(a) do
        let x: Int = a[i]
        if contains_int(b, x) then
            if contains_int(out, x) == false then
                out = append(out, x)
            end if
        end if
        i = i + 1
    end while
    return out
end func

/// CLI: `<ints...> -- <ints...>` (two lists separated by `--`).
func run(args: List[String]) -> Result[String, String]
    example ["1", "2", "3", "2", "--", "2", "4", "1"] -> Ok("intersect=[1, 2]")
    example ["1", "2", "--", "3", "4"] -> Ok("intersect=[]")
    example ["5", "5", "6", "--", "5"] -> Ok("intersect=[5]")
    example [] -> Err("usage: <ints...> -- <ints...>")
    example ["1", "2"] -> Err("usage: <ints...> -- <ints...>")
    example ["1", "--", "x"] -> Err("values must be integers")
    example ["a", "--", "1"] -> Err("values must be integers")
    var sep: Int = 0 - 1
    var i: Int = 0
    while i < length(args) do
        if args[i] == "--" then
            sep = i
        end if
        i = i + 1
    end while
    if sep < 0 then
        return Err("usage: <ints...> -- <ints...>")
    end if
    var a: List[Int] = []
    var j: Int = 0
    while j < sep do
        match parse_int(args[j]) with
        | None -> return Err("values must be integers")
        | Some(v) -> a = append(a, v)
        end match
        j = j + 1
    end while
    var b: List[Int] = []
    var k: Int = sep + 1
    while k < length(args) do
        match parse_int(args[k]) with
        | None -> return Err("values must be integers")
        | Some(v) -> b = append(b, v)
        end match
        k = k + 1
    end while
    return Ok("intersect=" + to_string(intersect(a, b)))
end func

@untested("entry point")
func main() -> String
    match run(["1", "2", "3", "2", "--", "2", "4", "1"]) with
    | Ok(a) ->
        match run(["5", "5", "6", "--", "5"]) with
        | Ok(b) -> return a + " | " + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

/// Arithmetic mean of integers as Float.

func mean(xs: List[Int]) -> Result[Float, String]
    example [1, 2, 3] -> Ok(2.0)
    example [2, 4] -> Ok(3.0)
    example [10] -> Ok(10.0)
    example [1, 1, 1, 1] -> Ok(1.0)
    example [1, 2, 3, 4, 5] -> Ok(3.0)
    example [] -> Err("empty list")
    if length(xs) == 0 then
        return Err("empty list")
    end if
    var sum: Int = 0
    var i: Int = 0
    while i < length(xs) do
        sum = sum + xs[i]
        i = i + 1
    end while
    return Ok(int_to_float(sum) / int_to_float(length(xs)))
end func

/// CLI: `<ints...>`.
func run(args: List[String]) -> Result[String, String]
    example ["1", "2", "3"] -> Ok("mean=2.0")
    example ["1", "2", "3", "4", "5"] -> Ok("mean=3.0")
    example ["10"] -> Ok("mean=10.0")
    example [] -> Err("usage: <ints...>")
    example ["x"] -> Err("values must be integers")
    if length(args) == 0 then
        return Err("usage: <ints...>")
    end if
    var xs: List[Int] = []
    var i: Int = 0
    while i < length(args) do
        match parse_int(args[i]) with
        | None -> return Err("values must be integers")
        | Some(v) -> xs = append(xs, v)
        end match
        i = i + 1
    end while
    match mean(xs) with
    | Err(e) -> return Err(e)
    | Ok(m) -> return Ok("mean=" + to_string(m))
    end match
end func

@untested("entry point")
func main() -> String
    match run(["1", "2", "3", "4", "5"]) with
    | Ok(a) ->
        match run(["2", "4"]) with
        | Ok(b) -> return a + " | " + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

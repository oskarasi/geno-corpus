/// Arithmetic mean of integers as Float.

func mean(xs: List[Int]) -> Result[Float, String]
    example [1, 2, 3] -> Ok(2.0)
    example [2, 4] -> Ok(3.0)
    example [10] -> Ok(10.0)
    example [1, 1, 1, 1] -> Ok(1.0)
    example [] -> Err("empty list")
    if length(xs) == 0 then
        return Err("empty list")
    end if
    var sum: Int = 0
    var i: Int = 0
    while i < length(xs) do
        sum = sum + xs[i]
        i = i + 1
    end while
    return Ok(int_to_float(sum) / int_to_float(length(xs)))
end func

@untested("entry point")
func main() -> String
    match mean([1, 2, 3, 4, 5]) with
    | Ok(m) -> return "mean=" + to_string(m)
    | Err(e) -> return "error: " + e
    end match
end func

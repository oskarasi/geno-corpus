/// Greatest common divisor via Euclidean algorithm.

func abs_int(n: Int) -> Int
    example 5 -> 5
    example -3 -> 3
    example 0 -> 0
    if n < 0 then
        return 0 - n
    else
        return n
    end if
end func

func gcd(a: Int, b: Int) -> Int
    example 48, 18 -> 6
    example 17, 13 -> 1
    example 0, 5 -> 5
    example 5, 0 -> 5
    example -12, 8 -> 4
    var x: Int = abs_int(a)
    var y: Int = abs_int(b)
    while y != 0 do
        let r: Int = x % y
        x = y
        y = r
    end while
    return x
end func

@untested("entry point")
func main() -> String
    return "gcd(48,18)=" + to_string(gcd(48, 18)) + " gcd(17,13)=" + to_string(gcd(17, 13))
end func

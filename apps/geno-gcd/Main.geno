/// Greatest common divisor via Euclidean algorithm.

func abs_int(n: Int) -> Int
    ensures result >= 0
    example 5 -> 5
    example -3 -> 3
    example 0 -> 0
    example -1 -> 1
    if n < 0 then
        return 0 - n
    else
        return n
    end if
end func

func gcd(a: Int, b: Int) -> Int
    ensures result >= 0
    example 48, 18 -> 6
    example 17, 13 -> 1
    example 0, 5 -> 5
    example 5, 0 -> 5
    example -12, 8 -> 4
    example 0, 0 -> 0
    example 100, 25 -> 25
    var x: Int = abs_int(a)
    var y: Int = abs_int(b)
    while y != 0 do
        let r: Int = x % y
        x = y
        y = r
    end while
    return x
end func

/// CLI: `<a> <b>`.
func run(args: List[String]) -> Result[String, String]
    example ["48", "18"] -> Ok("gcd=6")
    example ["17", "13"] -> Ok("gcd=1")
    example ["-12", "8"] -> Ok("gcd=4")
    example ["0", "0"] -> Ok("gcd=0")
    example [] -> Err("usage: <a> <b>")
    example ["48"] -> Err("usage: <a> <b>")
    example ["x", "18"] -> Err("a must be an integer")
    example ["48", "y"] -> Err("b must be an integer")
    if length(args) != 2 then
        return Err("usage: <a> <b>")
    end if
    match parse_int(args[0]) with
    | None -> return Err("a must be an integer")
    | Some(a) ->
        match parse_int(args[1]) with
        | None -> return Err("b must be an integer")
        | Some(b) -> return Ok("gcd=" + to_string(gcd(a, b)))
        end match
    end match
end func

@untested("entry point")
func main() -> String
    match run(["48", "18"]) with
    | Ok(a) ->
        match run(["17", "13"]) with
        | Ok(b) -> return a + " | " + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

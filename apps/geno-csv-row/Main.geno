/// Simple CSV row join (comma-separated, no quoting) and split.

import String

func join_row(fields: List[String]) -> String
    example [] -> ""
    example ["a"] -> "a"
    example ["a", "b", "c"] -> "a,b,c"
    example ["", "x"] -> ",x"
    example ["hello", "world"] -> "hello,world"
    var out: String = ""
    var i: Int = 0
    while i < length(fields) do
        if i > 0 then
            out = out + ","
        end if
        out = out + fields[i]
        i = i + 1
    end while
    return out
end func

func split_row(row: String) -> List[String]
    example "" -> [""]
    example "a" -> ["a"]
    example "a,b,c" -> ["a", "b", "c"]
    example ",x" -> ["", "x"]
    example "a,,b" -> ["a", "", "b"]
    var fields: List[String] = []
    var cur: String = ""
    var i: Int = 0
    while i < length(row) do
        let c: String = char_at(row, i)
        if c == "," then
            fields = append(fields, cur)
            cur = ""
        else
            cur = cur + c
        end if
        i = i + 1
    end while
    fields = append(fields, cur)
    return fields
end func

/// CLI: `join <fields...>` or `split <row>`
func run(args: List[String]) -> Result[String, String]
    example ["join", "a", "b", "c"] -> Ok("a,b,c")
    example ["join", "hello"] -> Ok("hello")
    example ["split", "a,b,c"] -> Ok("a | b | c")
    example ["split", ",x"] -> Ok(" | x")
    example [] -> Err("usage: join <fields...> | split <row>")
    example ["join"] -> Ok("")
    example ["nope"] -> Err("usage: join <fields...> | split <row>")
    example ["split"] -> Err("usage: join <fields...> | split <row>")
    if length(args) >= 1 and args[0] == "join" then
        let fields: List[String] = slice(list: args, start: 1, stop: length(args))
        return Ok(join_row(fields))
    end if
    if length(args) == 2 and args[0] == "split" then
        let parts: List[String] = split_row(args[1])
        return Ok(join(parts, " | "))
    end if
    return Err("usage: join <fields...> | split <row>")
end func

@untested("entry point")
func main() -> String
    match run(["join", "a", "b", "c"]) with
    | Ok(a) ->
        match run(["split", "a,b,c"]) with
        | Ok(b) -> return "join=" + a + " split=[" + b + "]"
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

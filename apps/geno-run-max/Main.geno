/// Running (prefix) maximums of a list of integers.

func run_max(xs: List[Int]) -> List[Int]
    example [1, 3, 2, 5, 4] -> [1, 3, 3, 5, 5]
    example [] -> []
    example [7] -> [7]
    example [5, 4, 3] -> [5, 5, 5]
    example [(-2), (-1), (-3)] -> [(-2), (-1), (-1)]
    example [1, 1, 1] -> [1, 1, 1]
    if length(xs) == 0 then
        return []
    end if
    var out: List[Int] = [xs[0]]
    var m: Int = xs[0]
    var i: Int = 1
    while i < length(xs) do
        if xs[i] > m then
            m = xs[i]
        end if
        out = append(out, m)
        i = i + 1
    end while
    return out
end func

func ints_csv(xs: List[Int]) -> String
    example [1, 2, 3] -> "1,2,3"
    example [] -> ""
    example [7] -> "7"
    var parts: List[String] = []
    var i: Int = 0
    while i < length(xs) do
        parts = append(parts, to_string(xs[i]))
        i = i + 1
    end while
    return join(parts, ",")
end func

/// CLI: `<ints...>` — empty args yields empty running max.
func run(args: List[String]) -> Result[String, String]
    example ["1", "3", "2", "5", "4"] -> Ok("1,3,3,5,5")
    example ["5", "4", "3"] -> Ok("5,5,5")
    example ["7"] -> Ok("7")
    example [] -> Ok("")
    example ["x"] -> Err("values must be integers")
    var xs: List[Int] = []
    var i: Int = 0
    while i < length(args) do
        match parse_int(args[i]) with
        | None -> return Err("values must be integers")
        | Some(v) -> xs = append(xs, v)
        end match
        i = i + 1
    end while
    return Ok(ints_csv(run_max(xs)))
end func

@untested("entry point")
func main() -> String
    match run(["1", "3", "2", "5", "4"]) with
    | Ok(a) ->
        match run(["5", "4", "3"]) with
        | Ok(b) -> return a + " | " + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

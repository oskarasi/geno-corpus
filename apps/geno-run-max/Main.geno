/// Running (prefix) maximums of a list of integers.

func run_max(xs: List[Int]) -> List[Int]
    example [1, 3, 2, 5, 4] -> [1, 3, 3, 5, 5]
    example [] -> []
    example [7] -> [7]
    example [5, 4, 3] -> [5, 5, 5]
    example [(-2), (-1), (-3)] -> [(-2), (-1), (-1)]
    if length(xs) == 0 then
        return []
    end if
    var out: List[Int] = [xs[0]]
    var m: Int = xs[0]
    var i: Int = 1
    while i < length(xs) do
        if xs[i] > m then
            m = xs[i]
        end if
        out = append(out, m)
        i = i + 1
    end while
    return out
end func

@untested("entry point")
func main() -> String
    return "run_max=" + to_string(run_max([1, 3, 2, 5, 4]))
end func

/// Factorial for non-negative integers.

func factorial(n: Int) -> Int
    requires n >= 0
    example 0 -> 1
    example 1 -> 1
    example 5 -> 120
    example 6 -> 720
    example 10 -> 3628800
    var result: Int = 1
    var i: Int = 2
    while i <= n do
        result = result * i
        i = i + 1
    end while
    return result
end func

@untested("entry point")
func main() -> String
    return "5!=" + to_string(factorial(5)) + " 10!=" + to_string(factorial(10))
end func

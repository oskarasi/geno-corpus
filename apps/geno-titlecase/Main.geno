/// Capitalize words split on spaces.

import String

func capitalize_word(word: String) -> String
    example "hello" -> "Hello"
    example "a" -> "A"
    example "" -> ""
    example "WORLD" -> "World"
    example "gEnO" -> "Geno"
    if length(word) == 0 then
        return ""
    end if
    let first: String = to_upper(char_at(word, 0))
    if length(word) == 1 then
        return first
    end if
    return first + to_lower(substring(text: word, start: 1, stop: length(word)))
end func

func title_case(text: String) -> String
    example "hello world" -> "Hello World"
    example "HELLO WORLD" -> "Hello World"
    example "a" -> "A"
    example "" -> ""
    example "the quick brown fox" -> "The Quick Brown Fox"
    example "mixed CASE words" -> "Mixed Case Words"
    if length(text) == 0 then
        return ""
    end if
    let words: List[String] = split(text, " ")
    var parts: List[String] = []
    var i: Int = 0
    while i < length(words) do
        parts = append(parts, capitalize_word(words[i]))
        i = i + 1
    end while
    return join(parts, " ")
end func

/// CLI: joins args with spaces, then title-cases.
func run(args: List[String]) -> Result[String, String]
    example ["hello", "world"] -> Ok("Hello World")
    example ["the", "quick", "brown", "fox"] -> Ok("The Quick Brown Fox")
    example ["HELLO"] -> Ok("Hello")
    example [] -> Err("usage: <words...>")
    if length(args) == 0 then
        return Err("usage: <words...>")
    end if
    return Ok(title_case(join(args, " ")))
end func

@untested("entry point")
func main() -> String
    match run(["the", "quick", "brown", "fox"]) with
    | Ok(a) ->
        match run(["HELLO", "WORLD"]) with
        | Ok(b) -> return a + " | " + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

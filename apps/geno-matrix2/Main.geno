/// Determinant of a 2x2 matrix [[a, b], [c, d]] = ad - bc.

func det2(a: Int, b: Int, c: Int, d: Int) -> Int
    example 1, 2, 3, 4 -> (-2)
    example 2, 0, 0, 2 -> 4
    example 5, 5, 5, 5 -> 0
    example 1, 0, 0, 1 -> 1
    example 3, 1, 2, 4 -> 10
    return a * d - b * c
end func

@untested("entry point")
func main() -> String
    let d: Int = det2(a: 1, b: 2, c: 3, d: 4)
    return "det([[1,2],[3,4]])=" + to_string(d)
end func

/// Insertion sort for List[Int], ascending.

func insert_sorted(sorted: List[Int], x: Int) -> List[Int]
    example [1, 3], 2 -> [1, 2, 3]
    example [], 5 -> [5]
    example [1, 2], 0 -> [0, 1, 2]
    example [1, 2], 3 -> [1, 2, 3]
    var out: List[Int] = []
    var inserted: Bool = false
    var i: Int = 0
    while i < length(sorted) do
        if inserted == false and x < sorted[i] then
            out = append(out, x)
            inserted = true
        end if
        out = append(out, sorted[i])
        i = i + 1
    end while
    if inserted == false then
        out = append(out, x)
    end if
    return out
end func

func sort_ints(xs: List[Int]) -> List[Int]
    example [3, 1, 2] -> [1, 2, 3]
    example [] -> []
    example [1] -> [1]
    example [5, 4, 3, 2, 1] -> [1, 2, 3, 4, 5]
    example [2, 2, 1] -> [1, 2, 2]
    var out: List[Int] = []
    var i: Int = 0
    while i < length(xs) do
        out = insert_sorted(out, xs[i])
        i = i + 1
    end while
    return out
end func

@untested("entry point")
func main() -> String
    let sorted: List[Int] = sort_ints([5, 1, 4, 2, 3])
    return "sorted_len=" + to_string(length(sorted)) + " first=" + to_string(sorted[0]) + " last=" + to_string(sorted[4])
end func

/// Collatz conjecture: count steps for n to reach 1.

func steps_to_one(n: Int) -> Result[Int, String]
    example 1 -> Ok(0)
    example 2 -> Ok(1)
    example 3 -> Ok(7)
    example 6 -> Ok(8)
    example 27 -> Ok(111)
    example 10 -> Ok(6)
    example 0 -> Err("n must be positive")
    example -1 -> Err("n must be positive")
    if n < 1 then
        return Err("n must be positive")
    end if
    var x: Int = n
    var steps: Int = 0
    while x != 1 do
        if x % 2 == 0 then
            x = x / 2
        else
            x = 3 * x + 1
        end if
        steps = steps + 1
    end while
    return Ok(steps)
end func

/// CLI: `<n>` with 1 <= n <= 1000000 for demo.
func run(args: List[String]) -> Result[String, String]
    example ["27"] -> Ok("steps=111")
    example ["1"] -> Ok("steps=0")
    example ["6"] -> Ok("steps=8")
    example ["0"] -> Err("n must be positive")
    example ["1000001"] -> Err("n too large (max 1000000 for demo)")
    example [] -> Err("usage: <n>")
    example ["1", "2"] -> Err("usage: <n>")
    example ["x"] -> Err("n must be an integer")
    if length(args) != 1 then
        return Err("usage: <n>")
    end if
    match parse_int(args[0]) with
    | None -> return Err("n must be an integer")
    | Some(n) ->
        if n > 1000000 then
            return Err("n too large (max 1000000 for demo)")
        end if
        match steps_to_one(n) with
        | Ok(s) -> return Ok("steps=" + to_string(s))
        | Err(e) -> return Err(e)
        end match
    end match
end func

@untested("entry point")
func main() -> String
    match run(["27"]) with
    | Ok(a) ->
        match run(["6"]) with
        | Ok(b) -> return a + " | " + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

/// Convert between kilograms and pounds (1 kg = 2.20462 lb).

func kg_to_lb(kg: Float) -> Float
    example 1.0 -> 2.20462
    example 0.0 -> 0.0
    example 2.0 -> 4.40924
    example 0.5 -> 1.10231
    return kg * 2.20462
end func

func lb_to_kg(lb: Float) -> Float
    example 2.20462 -> 1.0
    example 0.0 -> 0.0
    example 4.40924 -> 2.0
    return lb / 2.20462
end func

/// CLI: `kg2lb <kg>` | `lb2kg <lb>`.
func run(args: List[String]) -> Result[String, String]
    example ["kg2lb", "1"] -> Ok("2.20462")
    example ["lb2kg", "2.20462"] -> Ok("1.0")
    example ["kg2lb", "2"] -> Ok("4.40924")
    example [] -> Err("usage: kg2lb <kg> | lb2kg <lb>")
    example ["kg2lb"] -> Err("usage: kg2lb <kg> | lb2kg <lb>")
    example ["nope", "1"] -> Err("usage: kg2lb <kg> | lb2kg <lb>")
    example ["kg2lb", "x"] -> Err("value must be a float")
    if length(args) != 2 then
        return Err("usage: kg2lb <kg> | lb2kg <lb>")
    end if
    match parse_float(args[1]) with
    | None -> return Err("value must be a float")
    | Some(v) ->
        if args[0] == "kg2lb" then
            return Ok(to_string(kg_to_lb(v)))
        else if args[0] == "lb2kg" then
            return Ok(to_string(lb_to_kg(v)))
        else
            return Err("usage: kg2lb <kg> | lb2kg <lb>")
        end if
    end match
end func

@untested("entry point")
func main() -> String
    match run(["kg2lb", "1"]) with
    | Ok(a) ->
        match run(["lb2kg", "2.20462"]) with
        | Ok(b) -> return "1kg=" + a + "lb 2.20462lb=" + b + "kg"
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

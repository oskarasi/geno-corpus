/// Convert integers to ordinal strings: 1st, 2nd, 3rd, 11th, etc.

func ordinal(n: Int) -> String
    example 1 -> "1st"
    example 2 -> "2nd"
    example 3 -> "3rd"
    example 4 -> "4th"
    example 11 -> "11th"
    example 12 -> "12th"
    example 13 -> "13th"
    example 21 -> "21st"
    example 22 -> "22nd"
    example 23 -> "23rd"
    example 111 -> "111th"
    example 0 -> "0th"
    example 101 -> "101st"
    let mod100: Int = n % 100
    if mod100 >= 11 and mod100 <= 13 then
        return to_string(n) + "th"
    end if
    let mod10: Int = n % 10
    if mod10 == 1 then
        return to_string(n) + "st"
    else if mod10 == 2 then
        return to_string(n) + "nd"
    else if mod10 == 3 then
        return to_string(n) + "rd"
    else
        return to_string(n) + "th"
    end if
end func

/// CLI: `<n>`.
func run(args: List[String]) -> Result[String, String]
    example ["1"] -> Ok("1st")
    example ["22"] -> Ok("22nd")
    example ["11"] -> Ok("11th")
    example ["3"] -> Ok("3rd")
    example [] -> Err("usage: <n>")
    example ["1", "2"] -> Err("usage: <n>")
    example ["x"] -> Err("n must be an integer")
    if length(args) != 1 then
        return Err("usage: <n>")
    end if
    match parse_int(args[0]) with
    | None -> return Err("n must be an integer")
    | Some(n) -> return Ok(ordinal(n))
    end match
end func

@untested("entry point")
func main() -> String
    match run(["1"]) with
    | Ok(a) ->
        match run(["2"]) with
        | Ok(b) ->
            match run(["3"]) with
            | Ok(c) ->
                match run(["11"]) with
                | Ok(d) ->
                    match run(["22"]) with
                    | Ok(e) -> return a + " " + b + " " + c + " " + d + " " + e
                    | Err(msg) -> return "error: " + msg
                    end match
                | Err(msg) -> return "error: " + msg
                end match
            | Err(msg) -> return "error: " + msg
            end match
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

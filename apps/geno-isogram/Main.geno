/// An isogram has no repeating letters (case-insensitive); non-letters ignored.

import String

func is_letter(c: String) -> Bool
    example "a" -> true
    example "Z" -> true
    example "1" -> false
    example " " -> false
    example "-" -> false
    let lower: String = to_lower(c)
    return lower >= "a" and lower <= "z"
end func

func contains_char(xs: List[String], c: String) -> Bool
    example ["a", "b"], "b" -> true
    example ["a", "b"], "c" -> false
    example [], "a" -> false
    var i: Int = 0
    while i < length(xs) do
        if xs[i] == c then
            return true
        end if
        i = i + 1
    end while
    return false
end func

func is_isogram(text: String) -> Bool
    example "isogram" -> true
    example "Alphabet" -> false
    example "Dermatoglyphics" -> true
    example "aba" -> false
    example "moOse" -> false
    example "thumbscrew-japingly" -> true
    example "" -> true
    example "Eleven" -> false
    var seen: List[String] = []
    var i: Int = 0
    while i < length(text) do
        let c: String = char_at(text, i)
        if is_letter(c) then
            let lower: String = to_lower(c)
            if contains_char(seen, lower) then
                return false
            end if
            seen = append(seen, lower)
        end if
        i = i + 1
    end while
    return true
end func

/// CLI: joins all args with spaces as the text to check.
func run(args: List[String]) -> Result[String, String]
    example ["isogram"] -> Ok("isogram=true")
    example ["Alphabet"] -> Ok("isogram=false")
    example ["thumbscrew-japingly"] -> Ok("isogram=true")
    example ["Dermatoglyphics"] -> Ok("isogram=true")
    example [] -> Err("usage: <text...>")
    if length(args) == 0 then
        return Err("usage: <text...>")
    end if
    return Ok("isogram=" + to_string(is_isogram(join(args, " "))))
end func

@untested("entry point")
func main() -> String
    match run(["isogram"]) with
    | Ok(a) ->
        match run(["Alphabet"]) with
        | Ok(b) -> return a + " | " + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

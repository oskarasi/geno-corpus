/// Mask a credit-card number, keeping the last 4 digits.

import String

func is_digit(c: String) -> Bool
    example "0" -> true
    example "9" -> true
    example "a" -> false
    return c >= "0" and c <= "9"
end func

func digits_only(s: String) -> String
    example "4111-1111-1111-1111" -> "4111111111111111"
    example "12 34" -> "1234"
    example "abc" -> ""
    var out: String = ""
    var i: Int = 0
    while i < length(s) do
        let c: String = char_at(s, i)
        if is_digit(c) then
            out = out + c
        end if
        i = i + 1
    end while
    return out
end func

func mask(card: String) -> String
    example "4111111111111111" -> "************1111"
    example "4111-1111-1111-1111" -> "************1111"
    example "1234" -> "1234"
    example "12" -> "12"
    example "" -> ""
    let d: String = digits_only(card)
    let n: Int = length(d)
    if n <= 4 then
        return d
    end if
    var out: String = ""
    var i: Int = 0
    while i < n - 4 do
        out = out + "*"
        i = i + 1
    end while
    return out + substring(text: d, start: n - 4, stop: n)
end func

@untested("entry point")
func main() -> String
    return mask("4111-1111-1111-1111")
end func

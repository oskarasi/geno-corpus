/// Happy numbers: repeatedly replace with sum of squares of digits until 1 (happy) or a cycle (unhappy).

func sum_sq_digits(n: Int) -> Int
    example 19 -> 82
    example 82 -> 68
    example 1 -> 1
    example 0 -> 0
    var x: Int = n
    if x < 0 then
        x = 0 - x
    end if
    var sum: Int = 0
    while x > 0 do
        let d: Int = x % 10
        sum = sum + d * d
        x = x / 10
    end while
    return sum
end func

func contains_int(xs: List[Int], x: Int) -> Bool
    example [1, 2, 3], 2 -> true
    example [1, 2, 3], 9 -> false
    var i: Int = 0
    while i < length(xs) do
        if xs[i] == x then
            return true
        end if
        i = i + 1
    end while
    return false
end func

func is_happy(n: Int) -> Bool
    example 19 -> true
    example 7 -> true
    example 1 -> true
    example 2 -> false
    example 4 -> false
    example 0 -> false
    example (-19) -> false
    if n <= 0 then
        return false
    end if
    var seen: List[Int] = []
    var x: Int = n
    while x != 1 do
        if contains_int(seen, x) then
            return false
        end if
        seen = append(seen, x)
        x = sum_sq_digits(x)
    end while
    return true
end func

@untested("entry point")
func main() -> String
    return "19=" + to_string(is_happy(19)) + " 2=" + to_string(is_happy(2)) + " 7=" + to_string(is_happy(7))
end func

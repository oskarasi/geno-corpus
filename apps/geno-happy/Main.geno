/// Happy numbers: repeatedly replace with sum of squares of digits until 1 (happy) or a cycle (unhappy).

func sum_sq_digits(n: Int) -> Int
    ensures result >= 0
    example 19 -> 82
    example 82 -> 68
    example 1 -> 1
    example 0 -> 0
    example 7 -> 49
    var x: Int = n
    if x < 0 then
        x = 0 - x
    end if
    var sum: Int = 0
    while x > 0 do
        let d: Int = x % 10
        sum = sum + d * d
        x = x / 10
    end while
    return sum
end func

func contains_int(xs: List[Int], x: Int) -> Bool
    example [1, 2, 3], 2 -> true
    example [1, 2, 3], 9 -> false
    example [], 1 -> false
    example [7], 7 -> true
    var i: Int = 0
    while i < length(xs) do
        if xs[i] == x then
            return true
        end if
        i = i + 1
    end while
    return false
end func

func is_happy(n: Int) -> Bool
    example 19 -> true
    example 7 -> true
    example 1 -> true
    example 2 -> false
    example 4 -> false
    example 0 -> false
    example (-19) -> false
    example 10 -> true
    if n <= 0 then
        return false
    end if
    var seen: List[Int] = []
    var x: Int = n
    while x != 1 do
        if contains_int(seen, x) then
            return false
        end if
        seen = append(seen, x)
        x = sum_sq_digits(x)
    end while
    return true
end func

/// CLI: `check <n>`.
func run(args: List[String]) -> Result[String, String]
    example ["check", "19"] -> Ok("happy=true")
    example ["check", "2"] -> Ok("happy=false")
    example ["check", "7"] -> Ok("happy=true")
    example [] -> Err("usage: check <n>")
    example ["check"] -> Err("usage: check <n>")
    example ["nope", "19"] -> Err("usage: check <n>")
    example ["check", "x"] -> Err("n must be an integer")
    if length(args) != 2 then
        return Err("usage: check <n>")
    end if
    if args[0] != "check" then
        return Err("usage: check <n>")
    end if
    match parse_int(args[1]) with
    | None -> return Err("n must be an integer")
    | Some(n) ->
        var flag: String = "false"
        if is_happy(n) then
            flag = "true"
        end if
        return Ok("happy=" + flag)
    end match
end func

@untested("entry point")
func main() -> String
    match run(["check", "19"]) with
    | Ok(a) ->
        match run(["check", "2"]) with
        | Ok(b) ->
            match run(["check", "7"]) with
            | Ok(c) -> return a + " | " + b + " | " + c
            | Err(msg) -> return "error: " + msg
            end match
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

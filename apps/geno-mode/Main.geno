/// Mode (most frequent value). Ties break to the smaller value.

func count_of(xs: List[Int], target: Int) -> Int
    example [1, 2, 2, 3], 2 -> 2
    example [1, 1, 1], 1 -> 3
    example [], 5 -> 0
    example [4, 4, 4, 1], 4 -> 3
    var c: Int = 0
    var i: Int = 0
    while i < length(xs) do
        if xs[i] == target then
            c = c + 1
        end if
        i = i + 1
    end while
    return c
end func

func mode(xs: List[Int]) -> Result[Int, String]
    example [1, 2, 2, 3] -> Ok(2)
    example [1, 1, 2, 2] -> Ok(1)
    example [5] -> Ok(5)
    example [3, 1, 3, 1, 3] -> Ok(3)
    example [1, 2, 2, 3, 3, 3] -> Ok(3)
    example [] -> Err("empty list")
    if length(xs) == 0 then
        return Err("empty list")
    end if
    var best: Int = xs[0]
    var best_count: Int = count_of(xs, best)
    var i: Int = 1
    while i < length(xs) do
        let v: Int = xs[i]
        let c: Int = count_of(xs, v)
        if c > best_count then
            best = v
            best_count = c
        else if c == best_count and v < best then
            best = v
        end if
        i = i + 1
    end while
    return Ok(best)
end func

/// CLI: `<ints...>`.
func run(args: List[String]) -> Result[String, String]
    example ["1", "2", "2", "3"] -> Ok("mode=2")
    example ["1", "1", "2", "2"] -> Ok("mode=1")
    example ["1", "2", "2", "3", "3", "3"] -> Ok("mode=3")
    example [] -> Err("usage: <ints...>")
    example ["x"] -> Err("values must be integers")
    if length(args) == 0 then
        return Err("usage: <ints...>")
    end if
    var xs: List[Int] = []
    var i: Int = 0
    while i < length(args) do
        match parse_int(args[i]) with
        | None -> return Err("values must be integers")
        | Some(v) -> xs = append(xs, v)
        end match
        i = i + 1
    end while
    match mode(xs) with
    | Err(e) -> return Err(e)
    | Ok(m) -> return Ok("mode=" + to_string(m))
    end match
end func

@untested("entry point")
func main() -> String
    match run(["1", "2", "2", "3", "3", "3"]) with
    | Ok(a) ->
        match run(["1", "1", "2", "2"]) with
        | Ok(b) -> return a + " | " + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

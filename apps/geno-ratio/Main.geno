/// Simplify an integer ratio a:b using GCD.

func abs_int(n: Int) -> Int
    example 5 -> 5
    example -3 -> 3
    example 0 -> 0
    if n < 0 then
        return 0 - n
    else
        return n
    end if
end func

func gcd(a: Int, b: Int) -> Int
    example 48, 18 -> 6
    example 17, 13 -> 1
    example 0, 5 -> 5
    example 5, 0 -> 5
    example -12, 8 -> 4
    var x: Int = abs_int(a)
    var y: Int = abs_int(b)
    while y != 0 do
        let r: Int = x % y
        x = y
        y = r
    end while
    return x
end func

/// Return simplified [numerator, denominator]. Signs move to numerator; den > 0.
func simplify(a: Int, b: Int) -> Result[List[Int], String]
    example 2, 4 -> Ok([1, 2])
    example 15, 25 -> Ok([3, 5])
    example -2, 4 -> Ok([-1, 2])
    example 2, -4 -> Ok([-1, 2])
    example -6, -9 -> Ok([2, 3])
    example 0, 5 -> Ok([0, 1])
    example 7, 1 -> Ok([7, 1])
    example 3, 0 -> Err("denominator cannot be zero")
    if b == 0 then
        return Err("denominator cannot be zero")
    end if
    let g: Int = gcd(a, b)
    var num: Int = a / g
    var den: Int = b / g
    if den < 0 then
        num = 0 - num
        den = 0 - den
    end if
    return Ok([num, den])
end func

func describe(a: Int, b: Int) -> String
    example 2, 4 -> "2:4 -> 1:2"
    example 3, 0 -> "3:0 -> denominator cannot be zero"
    example 15, 25 -> "15:25 -> 3:5"
    match simplify(a, b) with
    | Ok(pair) -> return to_string(a) + ":" + to_string(b) + " -> " + to_string(pair[0]) + ":" + to_string(pair[1])
    | Err(msg) -> return to_string(a) + ":" + to_string(b) + " -> " + msg
    end match
end func

/// CLI: `<a> <b>`.
func run(args: List[String]) -> Result[String, String]
    example ["15", "25"] -> Ok("15:25 -> 3:5")
    example ["-6", "-9"] -> Ok("-6:-9 -> 2:3")
    example ["2", "4"] -> Ok("2:4 -> 1:2")
    example ["3", "0"] -> Ok("3:0 -> denominator cannot be zero")
    example [] -> Err("usage: <a> <b>")
    example ["15"] -> Err("usage: <a> <b>")
    example ["x", "25"] -> Err("a and b must be integers")
    if length(args) != 2 then
        return Err("usage: <a> <b>")
    end if
    match parse_int(args[0]) with
    | None -> return Err("a and b must be integers")
    | Some(a) ->
        match parse_int(args[1]) with
        | None -> return Err("a and b must be integers")
        | Some(b) -> return Ok(describe(a, b))
        end match
    end match
end func

@untested("entry point")
func main() -> String
    match run(["15", "25"]) with
    | Ok(a) ->
        match run(["-6", "-9"]) with
        | Ok(b) -> return a + " | " + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

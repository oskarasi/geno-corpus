/// Perfect square and perfect cube checks for non-negative integers.

func is_square(n: Int) -> Bool
    example 0 -> true
    example 1 -> true
    example 4 -> true
    example 9 -> true
    example 16 -> true
    example 2 -> false
    example 8 -> false
    example 15 -> false
    example (-4) -> false
    if n < 0 then
        return false
    end if
    var i: Int = 0
    while i * i < n do
        i = i + 1
    end while
    return i * i == n
end func

func is_cube(n: Int) -> Bool
    example 0 -> true
    example 1 -> true
    example 8 -> true
    example 27 -> true
    example 64 -> true
    example 2 -> false
    example 9 -> false
    example 26 -> false
    example (-8) -> false
    if n < 0 then
        return false
    end if
    var i: Int = 0
    while i * i * i < n do
        i = i + 1
    end while
    return i * i * i == n
end func

@untested("entry point")
func main() -> String
    return "16sq=" + to_string(is_square(16)) + " 8cube=" + to_string(is_cube(8)) + " 2sq=" + to_string(is_square(2))
end func

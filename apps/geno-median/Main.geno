/// Median of a list of integers (integer average for even length).

func sort_ints(xs: List[Int]) -> List[Int]
    example [3, 1, 2] -> [1, 2, 3]
    example [] -> []
    example [5] -> [5]
    example [2, 2, 1] -> [1, 2, 2]
    example [9, 1, 5, 3] -> [1, 3, 5, 9]
    var arr: List[Int] = xs
    var n: Int = length(arr)
    var i: Int = 0
    while i < n do
        var j: Int = 0
        while j < n - 1 - i do
            if arr[j] > arr[j + 1] then
                let tmp: Int = arr[j]
                arr = set_at(list: arr, index: j, value: arr[j + 1])
                arr = set_at(list: arr, index: j + 1, value: tmp)
            end if
            j = j + 1
        end while
        i = i + 1
    end while
    return arr
end func

func median(xs: List[Int]) -> Result[Int, String]
    example [1, 3, 2] -> Ok(2)
    example [1, 2, 3, 4] -> Ok(2)
    example [7] -> Ok(7)
    example [5, 1] -> Ok(3)
    example [1, 3, 2, 8, 5] -> Ok(3)
    example [] -> Err("empty list")
    if length(xs) == 0 then
        return Err("empty list")
    end if
    let sorted: List[Int] = sort_ints(xs)
    let n: Int = length(sorted)
    if n % 2 == 1 then
        return Ok(sorted[n / 2])
    else
        let a: Int = sorted[n / 2 - 1]
        let b: Int = sorted[n / 2]
        return Ok((a + b) / 2)
    end if
end func

/// CLI: `<ints...>`.
func run(args: List[String]) -> Result[String, String]
    example ["1", "3", "2"] -> Ok("median=2")
    example ["1", "2", "3", "4"] -> Ok("median=2")
    example ["1", "3", "2", "8", "5"] -> Ok("median=3")
    example [] -> Err("usage: <ints...>")
    example ["x"] -> Err("values must be integers")
    if length(args) == 0 then
        return Err("usage: <ints...>")
    end if
    var xs: List[Int] = []
    var i: Int = 0
    while i < length(args) do
        match parse_int(args[i]) with
        | None -> return Err("values must be integers")
        | Some(v) -> xs = append(xs, v)
        end match
        i = i + 1
    end while
    match median(xs) with
    | Err(e) -> return Err(e)
    | Ok(m) -> return Ok("median=" + to_string(m))
    end match
end func

@untested("entry point")
func main() -> String
    match run(["1", "3", "2", "8", "5"]) with
    | Ok(a) ->
        match run(["1", "2", "3", "4"]) with
        | Ok(b) -> return a + " | " + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

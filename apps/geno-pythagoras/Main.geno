/// Pythagorean theorem: hypotenuse from two legs.

import Math

func hypotenuse(a: Float, b: Float) -> Float
    example 3.0, 4.0 -> 5.0
    example 5.0, 12.0 -> 13.0
    example 0.0, 0.0 -> 0.0
    example 6.0, 8.0 -> 10.0
    return Math.sqrt(a * a + b * b)
end func

@untested("entry point")
func main() -> String
    let h: Float = hypotenuse(3.0, 4.0)
    let h2: Float = hypotenuse(5.0, 12.0)
    return "3-4-5 -> " + to_string(h) + " 5-12-13 -> " + to_string(h2)
end func

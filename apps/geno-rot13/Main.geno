/// ROT13 letter cipher; preserve case; leave non-letters unchanged.

import String

func rot13_char(ch: String) -> String
    example "a" -> "n"
    example "n" -> "a"
    example "A" -> "N"
    example "Z" -> "M"
    example "!" -> "!"
    example "m" -> "z"
    let lower: String = "abcdefghijklmnopqrstuvwxyz"
    let upper: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let lo: Int = String.index_of(lower, ch)
    if lo >= 0 then
        return String.char_at(lower, (lo + 13) % 26)
    end if
    let up: Int = String.index_of(upper, ch)
    if up >= 0 then
        return String.char_at(upper, (up + 13) % 26)
    end if
    return ch
end func

func rot13(text: String) -> String
    example "Hello" -> "Uryyb"
    example "Uryyb" -> "Hello"
    example "ABC xyz!" -> "NOP klm!"
    example "" -> ""
    example "Geno" -> "Trab"
    var result: String = ""
    var i: Int = 0
    while i < length(text) do
        result = result + rot13_char(String.char_at(text, i))
        i = i + 1
    end while
    return result
end func

/// CLI: joins all args with spaces as the text to transform.
func run(args: List[String]) -> Result[String, String]
    example ["Hello"] -> Ok("Uryyb")
    example ["Hello,", "Geno!"] -> Ok("Uryyb, Trab!")
    example ["Uryyb"] -> Ok("Hello")
    example [] -> Err("usage: <text...>")
    if length(args) == 0 then
        return Err("usage: <text...>")
    end if
    return Ok(rot13(join(args, " ")))
end func

@untested("entry point")
func main() -> String
    match run(["Hello,", "Geno!"]) with
    | Ok(cipher) ->
        match run([cipher]) with
        | Ok(back) -> return "plain=Hello, Geno! rot13=" + cipher + " back=" + back
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

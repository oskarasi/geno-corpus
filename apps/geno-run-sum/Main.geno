/// Running (prefix) sums of a list of integers.

func ints_csv(xs: List[Int]) -> String
    example [1, 2, 3] -> "1,2,3"
    example [] -> ""
    example [7] -> "7"
    var parts: List[String] = []
    var i: Int = 0
    while i < length(xs) do
        parts = append(parts, to_string(xs[i]))
        i = i + 1
    end while
    return join(parts, ",")
end func

func run_sum(xs: List[Int]) -> List[Int]
    example [1, 2, 3, 4] -> [1, 3, 6, 10]
    example [] -> []
    example [5] -> [5]
    example [1, (-1), 1] -> [1, 0, 1]
    example [10, 20, 30] -> [10, 30, 60]
    example [(-2), (-3)] -> [-2, -5]
    var out: List[Int] = []
    var sum: Int = 0
    var i: Int = 0
    while i < length(xs) do
        sum = sum + xs[i]
        out = append(out, sum)
        i = i + 1
    end while
    return out
end func

/// CLI: `sum <ints...>` — prefix sums as CSV.
func run(args: List[String]) -> Result[String, String]
    example ["sum", "1", "2", "3", "4"] -> Ok("1,3,6,10")
    example ["sum", "5"] -> Ok("5")
    example ["sum"] -> Ok("")
    example ["1", "2", "3"] -> Ok("1,3,6")
    example [] -> Err("usage: sum <ints...> | <ints...>")
    example ["sum", "x"] -> Err("values must be integers")
    var start: Int = 0
    if length(args) >= 1 and args[0] == "sum" then
        start = 1
    end if
    if length(args) == 0 then
        return Err("usage: sum <ints...> | <ints...>")
    end if
    var xs: List[Int] = []
    var i: Int = start
    while i < length(args) do
        match parse_int(args[i]) with
        | None -> return Err("values must be integers")
        | Some(v) -> xs = append(xs, v)
        end match
        i = i + 1
    end while
    return Ok(ints_csv(run_sum(xs)))
end func

@untested("entry point")
func main() -> String
    match run(["sum", "1", "2", "3", "4"]) with
    | Ok(a) ->
        match run(["sum", "10", "20", "30"]) with
        | Ok(b) -> return "1..4=[" + a + "] 10,20,30=[" + b + "]"
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

/// Binary encode/decode for non-negative integers.

import String

func int_to_binary(n: Int) -> Result[String, String]
    example 0 -> Ok("0")
    example 1 -> Ok("1")
    example 2 -> Ok("10")
    example 5 -> Ok("101")
    example 13 -> Ok("1101")
    example 255 -> Ok("11111111")
    example 42 -> Ok("101010")
    example -1 -> Err("n must be non-negative")
    if n < 0 then
        return Err("n must be non-negative")
    end if
    if n == 0 then
        return Ok("0")
    end if
    var x: Int = n
    var bits: String = ""
    while x > 0 do
        bits = to_string(x % 2) + bits
        x = x / 2
    end while
    return Ok(bits)
end func

func binary_to_int(s: String) -> Result[Int, String]
    example "0" -> Ok(0)
    example "1" -> Ok(1)
    example "10" -> Ok(2)
    example "101" -> Ok(5)
    example "1101" -> Ok(13)
    example "11111111" -> Ok(255)
    example "" -> Err("empty binary string")
    example "102" -> Err("invalid binary digit")
    example "abc" -> Err("invalid binary digit")
    if length(s) == 0 then
        return Err("empty binary string")
    end if
    var result: Int = 0
    var i: Int = 0
    while i < length(s) do
        let c: String = char_at(s, i)
        if c == "0" then
            result = result * 2
        else if c == "1" then
            result = result * 2 + 1
        else
            return Err("invalid binary digit")
        end if
        i = i + 1
    end while
    return Ok(result)
end func

/// CLI: `to <n>` | `from <bits>`.
func run(args: List[String]) -> Result[String, String]
    example ["to", "13"] -> Ok("1101")
    example ["from", "1101"] -> Ok("13")
    example ["to", "0"] -> Ok("0")
    example ["to", "-1"] -> Err("n must be non-negative")
    example ["from", "102"] -> Err("invalid binary digit")
    example [] -> Err("usage: to <n> | from <bits>")
    example ["to"] -> Err("usage: to <n> | from <bits>")
    example ["bogus", "1"] -> Err("usage: to <n> | from <bits>")
    example ["to", "x"] -> Err("n must be an integer")
    if length(args) != 2 then
        return Err("usage: to <n> | from <bits>")
    end if
    let cmd: String = args[0]
    let arg: String = args[1]
    if cmd == "to" then
        match parse_int(arg) with
        | None -> return Err("n must be an integer")
        | Some(n) -> return int_to_binary(n)
        end match
    end if
    if cmd == "from" then
        match binary_to_int(arg) with
        | Ok(v) -> return Ok(to_string(v))
        | Err(e) -> return Err(e)
        end match
    end if
    return Err("usage: to <n> | from <bits>")
end func

@untested("entry point")
func main() -> String
    match run(["to", "13"]) with
    | Ok(b) ->
        match run(["from", b]) with
        | Ok(v) -> return "13->" + b + "->" + v
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

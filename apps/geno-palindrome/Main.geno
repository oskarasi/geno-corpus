/// Palindrome checker ignoring case and spaces.

import String

func normalize(text: String) -> String
    example "Race Car" -> "racecar"
    example "A man a plan a canal Panama" -> "amanaplanacanalpanama"
    example "Hi" -> "hi"
    example "" -> ""
    example "  a  " -> "a"
    let lower: String = to_lower(text)
    var result: String = ""
    var i: Int = 0
    while i < length(lower) do
        let c: String = char_at(lower, i)
        if c != " " then
            result = result + c
        end if
        i = i + 1
    end while
    return result
end func

func is_palindrome(text: String) -> Bool
    example "racecar" -> true
    example "Race Car" -> true
    example "hello" -> false
    example "A man a plan a canal Panama" -> true
    example "" -> true
    example "a" -> true
    example "ab" -> false
    let s: String = normalize(text)
    var i: Int = 0
    var j: Int = length(s) - 1
    while i < j do
        if char_at(s, i) != char_at(s, j) then
            return false
        end if
        i = i + 1
        j = j - 1
    end while
    return true
end func

/// CLI: `check <text...>` (joins remaining args with spaces).
func run(args: List[String]) -> Result[String, String]
    example ["check", "racecar"] -> Ok("palindrome=true")
    example ["check", "Race", "Car"] -> Ok("palindrome=true")
    example ["check", "hello"] -> Ok("palindrome=false")
    example ["check", "A", "man", "a", "plan", "a", "canal", "Panama"] -> Ok("palindrome=true")
    example [] -> Err("usage: check <text...>")
    example ["check"] -> Err("usage: check <text...>")
    example ["nope", "x"] -> Err("usage: check <text...>")
    if length(args) < 2 then
        return Err("usage: check <text...>")
    end if
    if args[0] != "check" then
        return Err("usage: check <text...>")
    end if
    var words: List[String] = []
    var i: Int = 1
    while i < length(args) do
        words = append(words, args[i])
        i = i + 1
    end while
    let text: String = join(words, " ")
    var flag: String = "false"
    if is_palindrome(text) then
        flag = "true"
    end if
    return Ok("palindrome=" + flag)
end func

@untested("entry point")
func main() -> String
    match run(["check", "Race", "Car"]) with
    | Ok(a) ->
        match run(["check", "hello"]) with
        | Ok(b) -> return a + " | " + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

/// Atbash letter cipher (a<->z, b<->y, ...); preserve case; leave non-letters unchanged.

import String

func atbash_char(ch: String) -> String
    example "a" -> "z"
    example "z" -> "a"
    example "A" -> "Z"
    example "B" -> "Y"
    example "!" -> "!"
    example "m" -> "n"
    let lower: String = "abcdefghijklmnopqrstuvwxyz"
    let upper: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let lo: Int = String.index_of(lower, ch)
    if lo >= 0 then
        return String.char_at(lower, 25 - lo)
    end if
    let up: Int = String.index_of(upper, ch)
    if up >= 0 then
        return String.char_at(upper, 25 - up)
    end if
    return ch
end func

func atbash(text: String) -> String
    example "Hello" -> "Svool"
    example "Svool" -> "Hello"
    example "ABC xyz!" -> "ZYX cba!"
    example "" -> ""
    example "Geno" -> "Tvml"
    var result: String = ""
    var i: Int = 0
    while i < length(text) do
        result = result + atbash_char(String.char_at(text, i))
        i = i + 1
    end while
    return result
end func

/// CLI: joins all args with spaces as the text to transform.
func run(args: List[String]) -> Result[String, String]
    example ["Hello"] -> Ok("Svool")
    example ["Hello,", "Geno!"] -> Ok("Svool, Tvml!")
    example ["Svool"] -> Ok("Hello")
    example [] -> Err("usage: <text...>")
    if length(args) == 0 then
        return Err("usage: <text...>")
    end if
    return Ok(atbash(join(args, " ")))
end func

@untested("entry point")
func main() -> String
    match run(["Hello,", "Geno!"]) with
    | Ok(cipher) ->
        match run([cipher]) with
        | Ok(back) -> return "plain=Hello, Geno! atbash=" + cipher + " back=" + back
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

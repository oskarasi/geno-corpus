/// Format an integer cent amount as a dollar string with two decimals.

import String

func pad2(n: Int) -> String
    example 0 -> "00"
    example 5 -> "05"
    example 42 -> "42"
    if n < 10 then
        return "0" + to_string(n)
    else
        return to_string(n)
    end if
end func

func format_cents(cents: Int) -> String
    example 0 -> "$0.00"
    example 5 -> "$0.05"
    example 99 -> "$0.99"
    example 100 -> "$1.00"
    example 1234 -> "$12.34"
    example 10099 -> "$100.99"
    example (-50) -> "-$0.50"
    example (-1234) -> "-$12.34"
    var sign: String = ""
    var x: Int = cents
    if x < 0 then
        sign = "-"
        x = 0 - x
    end if
    let dollars: Int = x / 100
    let rem: Int = x % 100
    return sign + "$" + to_string(dollars) + "." + pad2(rem)
end func

@untested("entry point")
func main() -> String
    return format_cents(1234) + " " + format_cents((-50))
end func

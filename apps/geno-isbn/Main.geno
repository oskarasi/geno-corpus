/// ISBN-10 and ISBN-13 checksum validation.

import String

func is_digit(c: String) -> Bool
    example "0" -> true
    example "9" -> true
    example "X" -> false
    return c >= "0" and c <= "9"
end func

func digit_value(c: String) -> Int
    requires is_digit(c)
    example "0" -> 0
    example "7" -> 7
    example "9" -> 9
    return char_code(c) - char_code("0")
end func

/// Strip hyphens and spaces; leave other characters intact.
func normalize(isbn: String) -> String
    example "0-306-40615-2" -> "0306406152"
    example "978-0-306-40615-7" -> "9780306406157"
    example "0 306 40615 2" -> "0306406152"
    example "9780306406157" -> "9780306406157"
    example "" -> ""
    var result: String = ""
    var i: Int = 0
    while i < length(isbn) do
        let c: String = char_at(isbn, i)
        if c != "-" and c != " " then
            result = result + c
        end if
        i = i + 1
    end while
    return result
end func

func is_valid_isbn10(isbn: String) -> Bool
    example "0-306-40615-2" -> true
    example "0306406152" -> true
    example "0-306-40615-3" -> false
    example "123" -> false
    example "abcdefghij" -> false
    example "048665088X" -> true
    let s: String = normalize(isbn)
    if length(s) != 10 then
        return false
    end if
    var sum: Int = 0
    var i: Int = 0
    while i < 9 do
        let c: String = char_at(s, i)
        if not is_digit(c) then
            return false
        end if
        sum = sum + digit_value(c) * (10 - i)
        i = i + 1
    end while
    let check: String = char_at(s, 9)
    var check_val: Int = 0
    if check == "X" or check == "x" then
        check_val = 10
    else
        if not is_digit(check) then
            return false
        end if
        check_val = digit_value(check)
    end if
    sum = sum + check_val * 1
    return sum % 11 == 0
end func

func is_valid_isbn13(isbn: String) -> Bool
    example "978-0-306-40615-7" -> true
    example "9780306406157" -> true
    example "978-0-306-40615-8" -> false
    example "123" -> false
    example "978030640615X" -> false
    let s: String = normalize(isbn)
    if length(s) != 13 then
        return false
    end if
    var sum: Int = 0
    var i: Int = 0
    while i < 13 do
        let c: String = char_at(s, i)
        if not is_digit(c) then
            return false
        end if
        let d: Int = digit_value(c)
        if i % 2 == 0 then
            sum = sum + d
        else
            sum = sum + d * 3
        end if
        i = i + 1
    end while
    return sum % 10 == 0
end func

func validate(isbn: String) -> Result[String, String]
    example "0-306-40615-2" -> Ok("ISBN-10")
    example "978-0-306-40615-7" -> Ok("ISBN-13")
    example "0306406152" -> Ok("ISBN-10")
    example "9780306406157" -> Ok("ISBN-13")
    example "048665088X" -> Ok("ISBN-10")
    example "0-306-40615-3" -> Err("invalid checksum")
    example "12345" -> Err("not a valid ISBN-10 or ISBN-13")
    example "" -> Err("not a valid ISBN-10 or ISBN-13")
    let s: String = normalize(isbn)
    if length(s) == 10 then
        if is_valid_isbn10(s) then
            return Ok("ISBN-10")
        else
            return Err("invalid checksum")
        end if
    end if
    if length(s) == 13 then
        if is_valid_isbn13(s) then
            return Ok("ISBN-13")
        else
            return Err("invalid checksum")
        end if
    end if
    return Err("not a valid ISBN-10 or ISBN-13")
end func

func summarize(isbn: String) -> String
    example "0-306-40615-2" -> "0-306-40615-2 => ISBN-10"
    example "978-0-306-40615-7" -> "978-0-306-40615-7 => ISBN-13"
    example "bad" -> "bad => not a valid ISBN-10 or ISBN-13"
    match validate(isbn) with
        | Ok(kind) -> return isbn + " => " + kind
        | Err(msg) -> return isbn + " => " + msg
    end match
end func

/// Argv-style: `validate <isbn>` or bare `<isbn>`.
func run(args: List[String]) -> Result[String, String]
    example ["validate", "0-306-40615-2"] -> Ok("ISBN-10")
    example ["978-0-306-40615-7"] -> Ok("ISBN-13")
    example ["048665088X"] -> Ok("ISBN-10")
    example ["0-306-40615-3"] -> Err("invalid checksum")
    example [] -> Err("usage: validate <isbn> | <isbn>")
    example ["validate"] -> Err("usage: validate <isbn> | <isbn>")
    example ["validate", "12345"] -> Err("not a valid ISBN-10 or ISBN-13")

    if length(args) == 0 then
        return Err("usage: validate <isbn> | <isbn>")
    end if

    if args[0] == "validate" or args[0] == "check" then
        if length(args) < 2 then
            return Err("usage: validate <isbn> | <isbn>")
        end if
        return validate(args[1])
    end if

    return validate(args[0])
end func

@untested("entry point")
func main() -> String
    return join([
        summarize("0-306-40615-2"),
        summarize("978-0-306-40615-7"),
        summarize("0-306-40615-3"),
        summarize("12345")
    ], " | ")
end func

@untested("requires --unsafe --cap env,print")
func cli_main() -> Int
    let args: List[String] = cli_args()
    match run(args) with
    | Ok(out) ->
        print(out)
        return 0
    | Err(e) ->
        print(e)
        return 1
    end match
end func

/// Zip two integer lists into pairs [[x,y], ...], truncated to the shorter length.

func ints_csv(xs: List[Int]) -> String
    example [1, 2, 3] -> "1,2,3"
    example [] -> ""
    example [7] -> "7"
    var parts: List[String] = []
    var i: Int = 0
    while i < length(xs) do
        parts = append(parts, to_string(xs[i]))
        i = i + 1
    end while
    return join(parts, ",")
end func

func zip_csv(pairs: List[List[Int]]) -> String
    example [[1, 4], [2, 5]] -> "1:4,2:5"
    example [] -> ""
    example [[7, 8]] -> "7:8"
    var parts: List[String] = []
    var i: Int = 0
    while i < length(pairs) do
        let p: List[Int] = pairs[i]
        parts = append(parts, to_string(p[0]) + ":" + to_string(p[1]))
        i = i + 1
    end while
    return join(parts, ",")
end func

func zip_lists(xs: List[Int], ys: List[Int]) -> List[List[Int]]
    example [1, 2, 3], [4, 5, 6] -> [[1, 4], [2, 5], [3, 6]]
    example [1, 2], [9] -> [[1, 9]]
    example [], [1, 2] -> []
    example [1], [] -> []
    example [0], [0] -> [[0, 0]]
    var out: List[List[Int]] = []
    var i: Int = 0
    let n: Int = length(xs)
    let m: Int = length(ys)
    var lim: Int = n
    if m < n then
        lim = m
    end if
    while i < lim do
        out = append(out, [xs[i], ys[i]])
        i = i + 1
    end while
    return out
end func

func parse_ints(args: List[String], start: Int, stop: Int) -> Result[List[Int], String]
    example ["1", "2"], 0, 2 -> Ok([1, 2])
    example ["x"], 0, 1 -> Err("values must be integers")
    example [], 0, 0 -> Ok([])
    example ["a", "1", "2"], 1, 3 -> Ok([1, 2])
    var out: List[Int] = []
    var i: Int = start
    while i < stop do
        match parse_int(args[i]) with
        | None -> return Err("values must be integers")
        | Some(v) -> out = append(out, v)
        end match
        i = i + 1
    end while
    return Ok(out)
end func

/// CLI: `zip <xs...> -- <ys...>`.
func run(args: List[String]) -> Result[String, String]
    example ["zip", "1", "2", "3", "--", "4", "5", "6"] -> Ok("1:4,2:5,3:6")
    example ["zip", "1", "2", "--", "9"] -> Ok("1:9")
    example ["zip", "--", "1"] -> Ok("")
    example [] -> Err("usage: zip <xs...> -- <ys...>")
    example ["zip", "1", "2"] -> Err("usage: zip <xs...> -- <ys...>")
    example ["nope", "1", "--", "2"] -> Err("usage: zip <xs...> -- <ys...>")
    example ["zip", "x", "--", "1"] -> Err("values must be integers")
    if length(args) < 2 then
        return Err("usage: zip <xs...> -- <ys...>")
    end if
    if args[0] != "zip" then
        return Err("usage: zip <xs...> -- <ys...>")
    end if
    var sep: Int = -1
    var i: Int = 1
    while i < length(args) do
        if args[i] == "--" then
            sep = i
        end if
        i = i + 1
    end while
    if sep < 0 then
        return Err("usage: zip <xs...> -- <ys...>")
    end if
    match parse_ints(args: args, start: 1, stop: sep) with
    | Err(e) -> return Err(e)
    | Ok(xs) ->
        match parse_ints(args: args, start: sep + 1, stop: length(args)) with
        | Err(e) -> return Err(e)
        | Ok(ys) -> return Ok(zip_csv(zip_lists(xs, ys)))
        end match
    end match
end func

@untested("entry point")
func main() -> String
    match run(["zip", "1", "2", "3", "--", "4", "5"]) with
    | Ok(a) ->
        match run(["zip", "1", "2", "3", "--", "4", "5", "6"]) with
        | Ok(b) -> return "trunc=[" + a + "] full=[" + b + "]"
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

/// Set operations on List[Int] (order-preserving, deduplicated).

func contains_int(xs: List[Int], x: Int) -> Bool
    example [1, 2, 3], 2 -> true
    example [1, 2, 3], 9 -> false
    example [], 1 -> false
    example [0], 0 -> true
    var i: Int = 0
    while i < length(xs) do
        if xs[i] == x then
            return true
        end if
        i = i + 1
    end while
    return false
end func

func dedupe(xs: List[Int]) -> List[Int]
    example [1, 2, 2, 3, 1] -> [1, 2, 3]
    example [] -> []
    example [5, 5] -> [5]
    example [4, 1, 4] -> [4, 1]
    var out: List[Int] = []
    var i: Int = 0
    while i < length(xs) do
        if contains_int(out, xs[i]) == false then
            out = append(out, xs[i])
        end if
        i = i + 1
    end while
    return out
end func

func ints_csv(xs: List[Int]) -> String
    example [1, 2, 3] -> "1,2,3"
    example [] -> ""
    example [7] -> "7"
    var parts: List[String] = []
    var i: Int = 0
    while i < length(xs) do
        parts = append(parts, to_string(xs[i]))
        i = i + 1
    end while
    return join(parts, ",")
end func

func union(a: List[Int], b: List[Int]) -> List[Int]
    example [1, 2], [2, 3] -> [1, 2, 3]
    example [], [1] -> [1]
    example [1, 1], [1] -> [1]
    example [4], [5, 4] -> [4, 5]
    example [], [] -> []
    var out: List[Int] = dedupe(a)
    var i: Int = 0
    while i < length(b) do
        if contains_int(out, b[i]) == false then
            out = append(out, b[i])
        end if
        i = i + 1
    end while
    return out
end func

func intersect(a: List[Int], b: List[Int]) -> List[Int]
    example [1, 2, 3], [2, 4, 1] -> [1, 2]
    example [1, 2], [3, 4] -> []
    example [5, 5, 6], [5] -> [5]
    example [], [1] -> []
    example [9], [9] -> [9]
    var out: List[Int] = []
    var i: Int = 0
    let aa: List[Int] = dedupe(a)
    while i < length(aa) do
        if contains_int(b, aa[i]) then
            out = append(out, aa[i])
        end if
        i = i + 1
    end while
    return out
end func

func diff(a: List[Int], b: List[Int]) -> List[Int]
    example [1, 2, 3], [2, 4] -> [1, 3]
    example [1, 2], [1, 2] -> []
    example [5, 5], [5] -> []
    example [1], [] -> [1]
    example [], [1] -> []
    var out: List[Int] = []
    var i: Int = 0
    let aa: List[Int] = dedupe(a)
    while i < length(aa) do
        if contains_int(b, aa[i]) == false then
            out = append(out, aa[i])
        end if
        i = i + 1
    end while
    return out
end func

func parse_ints(args: List[String], start: Int, stop: Int) -> Result[List[Int], String]
    example ["1", "2"], 0, 2 -> Ok([1, 2])
    example ["x"], 0, 1 -> Err("values must be integers")
    example [], 0, 0 -> Ok([])
    example ["a", "1", "2", "b"], 1, 3 -> Ok([1, 2])
    var out: List[Int] = []
    var i: Int = start
    while i < stop do
        match parse_int(args[i]) with
        | None -> return Err("values must be integers")
        | Some(v) -> out = append(out, v)
        end match
        i = i + 1
    end while
    return Ok(out)
end func

/// CLI: `union|intersect|diff <a...> -- <b...>` (separator `--`).
func run(args: List[String]) -> Result[String, String]
    example ["union", "1", "2", "--", "2", "3"] -> Ok("1,2,3")
    example ["intersect", "1", "2", "3", "--", "2", "4", "1"] -> Ok("1,2")
    example ["diff", "1", "2", "3", "--", "2", "4"] -> Ok("1,3")
    example [] -> Err("usage: union|intersect|diff <a...> -- <b...>")
    example ["union", "1", "2"] -> Err("usage: union|intersect|diff <a...> -- <b...>")
    example ["nope", "1", "--", "2"] -> Err("usage: union|intersect|diff <a...> -- <b...>")
    example ["union", "x", "--", "1"] -> Err("values must be integers")
    if length(args) < 2 then
        return Err("usage: union|intersect|diff <a...> -- <b...>")
    end if
    let cmd: String = args[0]
    if cmd != "union" and cmd != "intersect" and cmd != "diff" then
        return Err("usage: union|intersect|diff <a...> -- <b...>")
    end if
    var sep: Int = -1
    var i: Int = 1
    while i < length(args) do
        if args[i] == "--" then
            sep = i
        end if
        i = i + 1
    end while
    if sep < 0 then
        return Err("usage: union|intersect|diff <a...> -- <b...>")
    end if
    match parse_ints(args: args, start: 1, stop: sep) with
    | Err(e) -> return Err(e)
    | Ok(left) ->
        match parse_ints(args: args, start: sep + 1, stop: length(args)) with
        | Err(e) -> return Err(e)
        | Ok(right) ->
            if cmd == "union" then
                return Ok(ints_csv(union(left, right)))
            else if cmd == "intersect" then
                return Ok(ints_csv(intersect(left, right)))
            else
                return Ok(ints_csv(diff(left, right)))
            end if
        end match
    end match
end func

@untested("entry point")
func main() -> String
    match run(["union", "1", "2", "--", "2", "3"]) with
    | Ok(u) ->
        match run(["intersect", "1", "2", "3", "--", "2", "4", "1"]) with
        | Ok(ix) ->
            match run(["diff", "1", "2", "3", "--", "2", "4"]) with
            | Ok(d) -> return "union=[" + u + "] intersect=[" + ix + "] diff=[" + d + "]"
            | Err(msg) -> return "error: " + msg
            end match
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

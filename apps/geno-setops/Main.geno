/// Set operations on List[Int] (order-preserving, deduplicated).

func contains_int(xs: List[Int], x: Int) -> Bool
    example [1, 2, 3], 2 -> true
    example [1, 2, 3], 9 -> false
    example [], 1 -> false
    var i: Int = 0
    while i < length(xs) do
        if xs[i] == x then
            return true
        end if
        i = i + 1
    end while
    return false
end func

func dedupe(xs: List[Int]) -> List[Int]
    example [1, 2, 2, 3, 1] -> [1, 2, 3]
    example [] -> []
    example [5, 5] -> [5]
    var out: List[Int] = []
    var i: Int = 0
    while i < length(xs) do
        if contains_int(out, xs[i]) == false then
            out = append(out, xs[i])
        end if
        i = i + 1
    end while
    return out
end func

func union(a: List[Int], b: List[Int]) -> List[Int]
    example [1, 2], [2, 3] -> [1, 2, 3]
    example [], [1] -> [1]
    example [1, 1], [1] -> [1]
    example [4], [5, 4] -> [4, 5]
    var out: List[Int] = dedupe(a)
    var i: Int = 0
    while i < length(b) do
        if contains_int(out, b[i]) == false then
            out = append(out, b[i])
        end if
        i = i + 1
    end while
    return out
end func

func intersect(a: List[Int], b: List[Int]) -> List[Int]
    example [1, 2, 3], [2, 4, 1] -> [1, 2]
    example [1, 2], [3, 4] -> []
    example [5, 5, 6], [5] -> [5]
    example [], [1] -> []
    var out: List[Int] = []
    var i: Int = 0
    let aa: List[Int] = dedupe(a)
    while i < length(aa) do
        if contains_int(b, aa[i]) then
            out = append(out, aa[i])
        end if
        i = i + 1
    end while
    return out
end func

func diff(a: List[Int], b: List[Int]) -> List[Int]
    example [1, 2, 3], [2, 4] -> [1, 3]
    example [1, 2], [1, 2] -> []
    example [5, 5], [5] -> []
    example [1], [] -> [1]
    var out: List[Int] = []
    var i: Int = 0
    let aa: List[Int] = dedupe(a)
    while i < length(aa) do
        if contains_int(b, aa[i]) == false then
            out = append(out, aa[i])
        end if
        i = i + 1
    end while
    return out
end func

@untested("entry point")
func main() -> String
    let u: List[Int] = union([1, 2], [2, 3])
    let i: List[Int] = intersect([1, 2, 3], [2, 4, 1])
    let d: List[Int] = diff([1, 2, 3], [2, 4])
    return "union_len=" + to_string(length(u)) + " intersect_len=" + to_string(length(i)) + " diff_len=" + to_string(length(d))
end func

/// Escape a string for inclusion inside a JSON string literal.

import String

func escape_char(c: String) -> String
    example "\\" -> "\\\\"
    example "\"" -> "\\\""
    example "\n" -> "\\n"
    example "\r" -> "\\r"
    example "\t" -> "\\t"
    example "a" -> "a"
    example " " -> " "
    if c == "\\" then
        return "\\\\"
    else if c == "\"" then
        return "\\\""
    else if c == "\n" then
        return "\\n"
    else if c == "\r" then
        return "\\r"
    else if c == "\t" then
        return "\\t"
    else
        return c
    end if
end func

func json_escape(s: String) -> String
    example "" -> ""
    example "hi" -> "hi"
    example "a\"b" -> "a\\\"b"
    example "a\\b" -> "a\\\\b"
    example "a\tb" -> "a\\tb"
    example "line\nbreak" -> "line\\nbreak"
    var out: String = ""
    var i: Int = 0
    while i < length(s) do
        out = out + escape_char(char_at(s, i))
        i = i + 1
    end while
    return out
end func

/// CLI: joins all args with spaces, then JSON-escapes.
func run(args: List[String]) -> Result[String, String]
    example ["hi"] -> Ok("hi")
    example ["say", "\"hi\""] -> Ok("say \\\"hi\\\"")
    example ["a\\b"] -> Ok("a\\\\b")
    example [] -> Err("usage: <text...>")
    if length(args) == 0 then
        return Err("usage: <text...>")
    end if
    return Ok(json_escape(join(args, " ")))
end func

@untested("entry point")
func main() -> String
    match run(["say", "\"hi\""]) with
    | Ok(a) ->
        match run(["a\\b"]) with
        | Ok(b) -> return a + " | " + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

/// Return the nth row (0-indexed) of Pascal's triangle as List[Int].

func pascal_row(n: Int) -> List[Int]
    example 0 -> [1]
    example 1 -> [1, 1]
    example 2 -> [1, 2, 1]
    example 3 -> [1, 3, 3, 1]
    example 4 -> [1, 4, 6, 4, 1]
    example 5 -> [1, 5, 10, 10, 5, 1]
    if n < 0 then
        return []
    end if
    var row: List[Int] = [1]
    var i: Int = 0
    while i < n do
        var next: List[Int] = [1]
        var j: Int = 0
        while j < length(row) - 1 do
            next = append(next, row[j] + row[j + 1])
            j = j + 1
        end while
        next = append(next, 1)
        row = next
        i = i + 1
    end while
    return row
end func

@untested("entry point")
func main() -> String
    let row: List[Int] = pascal_row(5)
    return "row5_len=" + to_string(length(row)) + " mid=" + to_string(row[2]) + " last=" + to_string(row[5])
end func

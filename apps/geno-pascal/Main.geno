/// Return the nth row (0-indexed) of Pascal's triangle as List[Int].

func pascal_row(n: Int) -> List[Int]
    requires n >= 0
    example 0 -> [1]
    example 1 -> [1, 1]
    example 2 -> [1, 2, 1]
    example 3 -> [1, 3, 3, 1]
    example 4 -> [1, 4, 6, 4, 1]
    example 5 -> [1, 5, 10, 10, 5, 1]
    example 6 -> [1, 6, 15, 20, 15, 6, 1]
    if n < 0 then
        return []
    end if
    var row: List[Int] = [1]
    var i: Int = 0
    while i < n do
        var next: List[Int] = [1]
        var j: Int = 0
        while j < length(row) - 1 do
            next = append(next, row[j] + row[j + 1])
            j = j + 1
        end while
        next = append(next, 1)
        row = next
        i = i + 1
    end while
    return row
end func

func ints_csv(xs: List[Int]) -> String
    example [1, 2, 3] -> "1,2,3"
    example [] -> ""
    example [7] -> "7"
    var parts: List[String] = []
    var i: Int = 0
    while i < length(xs) do
        parts = append(parts, to_string(xs[i]))
        i = i + 1
    end while
    return join(parts, ",")
end func

/// CLI: `<n>` with 0 <= n <= 20 for demo.
func run(args: List[String]) -> Result[String, String]
    example ["5"] -> Ok("row=1,5,10,10,5,1")
    example ["0"] -> Ok("row=1")
    example ["3"] -> Ok("row=1,3,3,1")
    example ["21"] -> Err("n too large (max 20 for demo)")
    example ["-1"] -> Err("n must be non-negative")
    example [] -> Err("usage: <n>")
    example ["1", "2"] -> Err("usage: <n>")
    example ["x"] -> Err("n must be an integer")
    if length(args) != 1 then
        return Err("usage: <n>")
    end if
    match parse_int(args[0]) with
    | None -> return Err("n must be an integer")
    | Some(n) ->
        if n < 0 then
            return Err("n must be non-negative")
        end if
        if n > 20 then
            return Err("n too large (max 20 for demo)")
        end if
        return Ok("row=" + ints_csv(pascal_row(n)))
    end match
end func

@untested("entry point")
func main() -> String
    match run(["5"]) with
    | Ok(a) ->
        match run(["3"]) with
        | Ok(b) -> return a + " | " + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

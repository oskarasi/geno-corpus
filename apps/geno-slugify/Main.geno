/// Slugify: lowercase, spaces to hyphens, keep letters/digits only.

import String

func is_alnum(c: String) -> Bool
    example "a" -> true
    example "Z" -> true
    example "5" -> true
    example "-" -> false
    example "!" -> false
    example "_" -> false
    return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9")
end func

func slugify(text: String) -> String
    example "Hello World" -> "hello-world"
    example "Foo  Bar!" -> "foo-bar"
    example "Already-slug" -> "already-slug"
    example "  spaced  " -> "spaced"
    example "A_B C" -> "ab-c"
    example "" -> ""
    example "---" -> ""
    let lower: String = to_lower(text)
    var result: String = ""
    var i: Int = 0
    var last_dash: Bool = true
    while i < length(lower) do
        let c: String = char_at(lower, i)
        if is_alnum(c) then
            result = result + c
            last_dash = false
        else if c == " " or c == "-" then
            if not last_dash then
                result = result + "-"
                last_dash = true
            end if
        end if
        i = i + 1
    end while
    if length(result) > 0 and char_at(result, length(result) - 1) == "-" then
        result = substring(text: result, start: 0, stop: length(result) - 1)
    end if
    return result
end func

/// CLI: joins all args with spaces, then slugifies.
func run(args: List[String]) -> Result[String, String]
    example ["Hello", "World"] -> Ok("hello-world")
    example ["Foo", "Bar!"] -> Ok("foo-bar")
    example ["Already-slug"] -> Ok("already-slug")
    example [] -> Err("usage: <text...>")
    example ["  spaced  "] -> Ok("spaced")
    if length(args) == 0 then
        return Err("usage: <text...>")
    end if
    return Ok(slugify(join(args, " ")))
end func

@untested("entry point")
func main() -> String
    match run(["Hello", "World!"]) with
    | Ok(a) ->
        match run(["Foo", "Bar", "Baz"]) with
        | Ok(b) -> return a + " | " + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func

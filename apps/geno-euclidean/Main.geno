/// Euclidean distance between 2D integer points (returns Float).

import Math

func euclidean(x1: Int, y1: Int, x2: Int, y2: Int) -> Float
    ensures result >= 0.0
    example 0, 0, 3, 4 -> 5.0
    example 1, 1, 1, 1 -> 0.0
    example 0, 0, 5, 12 -> 13.0
    example (-3), 0, 0, 4 -> 5.0
    example 0, 0, 0, 0 -> 0.0
    let dx: Float = (x1 - x2) * 1.0
    let dy: Float = (y1 - y2) * 1.0
    return Math.sqrt(dx * dx + dy * dy)
end func

/// CLI: `<x1> <y1> <x2> <y2>`
func run(args: List[String]) -> Result[String, String]
    example ["0", "0", "3", "4"] -> Ok("distance=5.0")
    example ["0", "0", "5", "12"] -> Ok("distance=13.0")
    example ["1", "1", "1", "1"] -> Ok("distance=0.0")
    example ["-3", "0", "0", "4"] -> Ok("distance=5.0")
    example [] -> Err("usage: <x1> <y1> <x2> <y2>")
    example ["0", "0", "3"] -> Err("usage: <x1> <y1> <x2> <y2>")
    example ["x", "0", "3", "4"] -> Err("coordinates must be integers")
    example ["0", "0", "3", "y"] -> Err("coordinates must be integers")
    if length(args) != 4 then
        return Err("usage: <x1> <y1> <x2> <y2>")
    end if
    match parse_int(args[0]) with
    | None -> return Err("coordinates must be integers")
    | Some(x1) ->
        match parse_int(args[1]) with
        | None -> return Err("coordinates must be integers")
        | Some(y1) ->
            match parse_int(args[2]) with
            | None -> return Err("coordinates must be integers")
            | Some(x2) ->
                match parse_int(args[3]) with
                | None -> return Err("coordinates must be integers")
                | Some(y2) ->
                    let d: Float = euclidean(x1: x1, y1: y1, x2: x2, y2: y2)
                    return Ok("distance=" + to_string(d))
                end match
            end match
        end match
    end match
end func

@untested("entry point")
func main() -> String
    match run(["0", "0", "3", "4"]) with
    | Ok(a) ->
        match run(["0", "0", "5", "12"]) with
        | Ok(b) -> return "d(0,0)-(3,4)=" + a + " d(0,0)-(5,12)=" + b
        | Err(msg) -> return "error: " + msg
        end match
    | Err(msg) -> return "error: " + msg
    end match
end func
